{% extends "templates/usluga.twig" %}
{# Porównywarka newsletterów sklepów (repo Autilos/audyt-mailingu, porownywarka/wp/). 26.11.2026
   Wszystkie liczby z jednego pliku: function('mkpk_porownywarka_dane') = uploads/mkpk-porownywarka/dane.json
   (generuje porownywarka/generuj_dane.py). Style zawężone do .usl .pn. Formularz: mu-plugins/mkpk-porownywarka.php. #}
{% block custom_head %}
{{ parent() }}
<style>
.usl .pn{--czerw:#c8102e;--linia:rgba(215,187,121,.28);--pas:#5a161d}
.usl .pn section{scroll-margin-top:70px;padding:48px 0 0}
.usl .pn .pn-hero{padding:40px 0 0}
.usl .pn h1{font-size:clamp(2.1rem,7vw,4.2rem)}
.usl .pn .u-lead{margin-top:18px!important}
.usl .pn .pn-uwaga{margin:22px 0 0;max-width:760px;border-left:4px solid var(--czerw);background:rgba(200,16,46,.12);padding:14px 16px;border-radius:0 8px 8px 0;font-size:.98rem}
.usl .pn .pn-uwaga b{color:#fff4dc}
.usl .pn .pn-przyciski{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.usl .pn .pn-przyciski .u-cta{margin:0}
.usl .pn .pn-btn2{display:inline-block;border:1px solid var(--zloto);color:var(--tekst)!important;text-decoration:none;padding:13px 22px;border-radius:6px;font-weight:600}
.usl .pn .pn-btn2:hover{background:rgba(215,187,121,.12)}
.usl .pn .u-status{grid-template-columns:repeat(4,auto)}
/* wybór branży */
.usl .pn .pn-wybor{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}
.usl .pn .pn-wybor button{font:600 .95rem/1.2 inherit;font-family:inherit;color:var(--tekst);background:rgba(41,0,4,.7);border:1px solid var(--linia);border-radius:999px;padding:10px 16px;cursor:pointer;min-height:44px}
.usl .pn .pn-wybor button small{font-family:var(--mono);font-weight:400;color:var(--szary);margin-left:6px;font-size:.75rem}
.usl .pn .pn-wybor button[aria-selected=true]{background:var(--zloto);color:#290004;border-color:var(--zloto)}
.usl .pn .pn-wybor button[aria-selected=true] small{color:#5a3b10}
.usl .pn .pn-wybor button:focus-visible{outline:2px solid #fff;outline-offset:2px}
/* karta branży */
.usl .pn .pn-karta{background:linear-gradient(180deg,var(--karta),var(--tlo2));border:1px solid rgba(215,187,121,.35);border-top:3px solid var(--czerw);border-radius:14px;padding:22px 18px}
.usl .pn .pn-karta[hidden]{display:none}
.usl .pn .pn-karta > h3{font-size:1.35rem;margin:0 0 4px}
.usl .pn .pn-karta > .pn-pod{color:var(--szary);font-size:.92rem;margin:0 0 18px}
.usl .pn .pn-kafle{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.usl .pn .pn-kafel{background:rgba(20,0,2,.55);border:1px solid var(--linia);border-radius:10px;padding:14px}
.usl .pn .pn-kafel span{display:block;font-family:var(--mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--zloto);line-height:1.35}
.usl .pn .pn-kafel b{display:block;font-size:2rem;line-height:1.1;margin:8px 0 4px;color:#fff4dc;font-weight:800}
.usl .pn .pn-kafel b small{font-size:1rem;font-weight:600;color:var(--szary)}
.usl .pn .pn-kafel p{margin:0;font-size:.85rem;color:var(--szary);line-height:1.45}
.usl .pn .pn-blok{margin-top:22px}
.usl .pn .pn-blok h4{margin:0 0 10px;font-size:1rem;color:#fff4dc}
.usl .pn .pn-blok p{font-size:.95rem}
.usl .pn .pn-dni{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;align-items:end;height:120px;margin:0 0 6px}
.usl .pn .pn-dni div{display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;gap:4px}
.usl .pn .pn-dni i{display:block;width:100%;max-width:44px;background:var(--zloto);border-radius:4px 4px 0 0;min-height:2px}
.usl .pn .pn-dni em{font-style:normal;font-family:var(--mono);font-size:.72rem;color:var(--szary)}
.usl .pn .pn-dni-podpis{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;text-align:center;font-family:var(--mono);font-size:.75rem;color:var(--zloto);margin-bottom:10px}
.usl .pn .pn-paski{display:grid;gap:10px}
.usl .pn .pn-pasek{display:grid;grid-template-columns:minmax(0,1fr) 46px;gap:4px 10px;align-items:center;font-size:.92rem}
.usl .pn .pn-pasek > span{grid-column:1/-1}
.usl .pn .pn-pasek div{height:10px;background:rgba(215,187,121,.15);border-radius:5px;overflow:hidden}
.usl .pn .pn-pasek div i{display:block;height:100%;background:var(--zloto)}
.usl .pn .pn-pasek b{font-family:var(--mono);text-align:right;font-size:.9rem}
.usl .pn .pn-chipy{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 8px;padding:0;list-style:none}
.usl .pn .pn-chipy li{border:1px solid var(--linia);border-radius:6px;padding:4px 10px;font-size:.88rem;background:rgba(20,0,2,.5)}
.usl .pn .pn-chipy li b{font-family:var(--mono);color:var(--zloto);font-weight:400;margin-left:4px}
.usl .pn .pn-drobne{font-size:.85rem;color:var(--szary);margin:6px 0 0}
/* ciekawostki */
.usl .pn .pn-ciek{display:grid;grid-template-columns:1fr;gap:12px}
.usl .pn .pn-ciek div{border:1px solid var(--linia);border-radius:12px;padding:16px 18px;background:rgba(41,0,4,.6)}
.usl .pn .pn-ciek b{display:block;font-size:1.9rem;line-height:1.1;color:var(--zloto);font-weight:800;margin-bottom:4px}
.usl .pn .pn-ciek p{margin:0;font-size:.95rem}
/* dodaj sklep */
.usl .pn .pn-sciezki{display:grid;grid-template-columns:1fr;gap:16px}
.usl .pn .pn-sciezka{border:1px solid var(--zloto);border-radius:14px;padding:22px 18px;background:linear-gradient(180deg,var(--karta),var(--tlo2))}
.usl .pn .pn-sciezka .pn-etyk{display:inline-block;font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;background:var(--czerw);color:#fff;padding:3px 8px;border-radius:3px;margin-bottom:10px}
.usl .pn .pn-sciezka h3{margin:0 0 8px;font-size:1.25rem}
.usl .pn form{display:grid;gap:14px;margin-top:16px}
.usl .pn form label{display:grid;gap:5px;font-size:.85rem;color:var(--zloto);font-weight:600}
.usl .pn form input[type=text],.usl .pn form input[type=email],.usl .pn form select{width:100%;padding:12px 13px;border-radius:8px;border:1px solid rgba(215,187,121,.55);background:#140002;color:#fff;font-size:16px;line-height:1.4;font-family:inherit}
.usl .pn form input:focus,.usl .pn form select:focus{outline:2px solid var(--zloto);outline-offset:1px}
.usl .pn form .pn-zgoda{display:flex;gap:10px;align-items:flex-start;color:var(--tekst);font-weight:400;font-size:.9rem}
.usl .pn form .pn-zgoda input{margin-top:4px;width:20px;height:20px;flex:none;accent-color:#d7bb79}
.usl .pn form .pn-pulapka{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.usl .pn form button{background:var(--zloto);color:#290004;font-weight:700;font-size:1rem;border:0;border-radius:8px;padding:14px 26px;cursor:pointer;min-height:48px}
.usl .pn form button[disabled]{opacity:.6;cursor:wait}
.usl .pn .pn-status{min-height:1.4em;margin:0;font-weight:600}
.usl .pn .pn-status.ok{color:#86efac}
.usl .pn .pn-status.blad{color:#ff8a94}
.usl .pn .pn-metoda{max-width:820px;padding-left:20px}
.usl .pn .pn-metoda li{margin:0 0 10px}
@media (min-width:700px){
  .usl .pn .pn-kafle{grid-template-columns:repeat(4,1fr)}
  .usl .pn .pn-karta{padding:28px 28px}
  .usl .pn .pn-ciek{grid-template-columns:repeat(2,1fr)}
  .usl .pn .pn-dwie{display:grid;grid-template-columns:1fr 1fr;gap:28px}
  .usl .pn .pn-sciezki{grid-template-columns:1.25fr 1fr}
  .usl .pn form .pn-dwa{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .usl .pn form button{justify-self:start}
}
@media (min-width:1000px){.usl .pn .pn-ciek{grid-template-columns:repeat(3,1fr)}}
@media (max-width:820px){.usl .pn .u-status{grid-template-columns:1fr 1fr}}
@media (max-width:699px){.usl .pn form button{width:100%}}
</style>
{% endblock %}

{% block content %}
{% set d = function('mkpk_porownywarka_dane') %}
<div class="usl"><div class="pn">
{% if not d %}
  <section class="pn-hero">
    <div class="u-kicker">Porównywarka newsletterów</div>
    <h1>Jak mailują polskie sklepy?</h1>
    <p class="u-lead">Dane są w przygotowaniu. Zajrzyj za kilka dni.</p>
  </section>
{% else %}
  {% set l = d.liczby %}
  {% set o = d.okres %}
  <section class="pn-hero">
    <div class="u-kicker">Porównywarka newsletterów · {{ o.od_pl }}–{{ o.do_pl }}</div>
    <h1>Jak mailują polskie sklepy?</h1>
    <p class="u-lead">Zapisałem się do newsletterów {{ l.sklepy_zapisane }} polskich sklepów i liczę każdy mail, który przychodzi. Przez {{ o.dni }} dni, od {{ o.od_pl }} do {{ o.do_pl }}, przyszło {{ l.maile }} maili od {{ l.sklepy_wysylajace }} sklepów. Wybierz branżę i zobacz, jak często piszą, kiedy i o czym.</p>
    <p class="pn-uwaga"><b>Ważne: w tym okresie był Black Week.</b> Sklepy wysyłały wtedy więcej maili z rabatami niż zwykle, więc udział maili sprzedażowych i liczba maili w tygodniu są wyższe niż w spokojnym miesiącu.</p>
    <div class="pn-przyciski">
      <a class="u-cta" href="#branze">Wybierz branżę</a>
      <a class="pn-btn2" href="#dodaj">Dodaj swój sklep</a>
    </div>
    <div class="u-status">
      <div><span>Maili</span><b>{{ l.maile }}</b></div>
      <div><span>Sklepów, które pisały</span><b>{{ l.sklepy_wysylajace }}</b></div>
      <div><span>Branż do porównania</span><b>{{ d.branze|length }}</b></div>
      <div><span>Okres</span><b>{{ o.dni }} dni</b></div>
    </div>
  </section>

  <section id="branze">
    <div class="u-kicker">Porównanie branż</div>
    <h2>Wybierz branżę</h2>
    <div class="pn-wybor" role="tablist" aria-label="Branże">
      {% for b in d.branze %}
      <button type="button" role="tab" id="pn-tab-{{ b.slug }}" aria-controls="pn-{{ b.slug }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" data-branza="{{ b.slug }}">{{ b.nazwa }}<small>{{ b.sklepy }}</small></button>
      {% endfor %}
    </div>

    {% for b in d.branze %}
    {% set t = b.tydzien %}
    <article class="pn-karta" id="pn-{{ b.slug }}" role="tabpanel" aria-labelledby="pn-tab-{{ b.slug }}" data-panel="{{ b.slug }}">
      <h3>{{ b.nazwa }}</h3>
      <p class="pn-pod">{{ b.sklepy }} sklepów, {{ b.maile }} maili, w tym {{ b.regularne }} zwykłych newsletterów (bez potwierdzenia zapisu i powitania).{% if b.malo_danych %} <b>Mało maili, więc traktuj te liczby orientacyjnie.</b>{% endif %}</p>
      <div class="pn-kafle">
        <div class="pn-kafel"><span>Newsletterów tygodniowo</span>
          {% if t.mediana is not null %}<b>{{ t.mediana }}</b><p>Tyle wysyła typowy sklep. Rozrzut: od {{ t.od }} do {{ t.do }} ({{ t.sklepy }} sklepów obserwowanych co najmniej tydzień).</p>
          {% else %}<b>–</b><p>Za krótko obserwujemy sklepy z tej branży (mniej niż tydzień).</p>{% endif %}
        </div>
        <div class="pn-kafel"><span>Maile sprzedażowe</span><b>{{ b.sprzedazowe_proc ?? '–' }}%</b><p>zwykłych newsletterów to oferta, rabat albo zachęta do zakupu.</p></div>
        <div class="pn-kafel"><span>Potwierdzenie zapisu</span><b>{{ b.potwierdzenie.prosi }}<small> z {{ b.potwierdzenie.sklepy }}</small></b><p>sklepów prosi o kliknięcie w link potwierdzający{% if b.potwierdzenie.z_zacheta %}, {{ b.potwierdzenie.z_zacheta }} z rabatem w temacie tego maila{% endif %}.</p></div>
        <div class="pn-kafel"><span>Rabat na powitanie</span>
          {% if b.powitanie.sklepy %}<b>{{ b.powitanie.z_rabatem }}<small> z {{ b.powitanie.sklepy }}</small></b><p>sklepów z mailem powitalnym daje w nim rabat albo kod.</p>
          {% else %}<b>–</b><p>Żaden sklep z tej branży nie przysłał maila powitalnego.</p>{% endif %}
        </div>
      </div>

      <div class="pn-dwie">
        <div class="pn-blok">
          <h4>W jakie dni przychodzą</h4>
          <div class="pn-dni" aria-hidden="true">
            {% for x in b.dni %}<div><em>{{ x.proc }}%</em><i style="height:{{ (x.wys * 0.78)|round }}%"></i></div>{% endfor %}
          </div>
          <div class="pn-dni-podpis" aria-hidden="true">{% for x in b.dni %}<span>{{ x.dzien }}</span>{% endfor %}</div>
          <p>{% if b.dni_top %}Najwięcej zwykłych newsletterów przyszło {{ b.dni_top|join(', ') }}.{% else %}Maile rozkładają się na różne dni bez wyraźnej przewagi.{% endif %}
          {% if b.godziny_top %}Najczęstsze godziny: {{ b.godziny_top|join(', ') }}.{% else %}Godziny są rozrzucone, bez wyraźnej przewagi.{% endif %}</p>
        </div>
        <div class="pn-blok">
          <h4>Co jest w tematach maili</h4>
          <div class="pn-paski">
            {% for p in [['słowo „rabat”', b.tematy.rabat], ['znak procentu (%)', b.tematy.procent], ['emoji', b.tematy.emoji], ['„Black” albo „Cyber” (Black Friday, Black Week…)', b.tematy.black]] %}
            <div class="pn-pasek"><span>{{ p[0] }}</span><div><i style="width:{{ p[1] }}%"></i></div><b>{{ p[1] }}%</b></div>
            {% endfor %}
          </div>
          <p class="pn-drobne">Udział wśród {{ b.regularne }} zwykłych newsletterów tej branży.</p>
        </div>
      </div>

      <div class="pn-dwie">
        <div class="pn-blok">
          <h4>Programy do wysyłki maili</h4>
          {% if b.systemy %}
          <ul class="pn-chipy">{% for s in b.systemy %}<li>{{ s.nazwa }}<b>{{ s.sklepy }}</b></li>{% endfor %}</ul>
          <p class="pn-drobne">Rozpoznane u {{ b.systemy_rozpoznane }} z {{ b.sklepy }} sklepów, po technicznych nagłówkach maili.</p>
          {% else %}
          <p class="pn-drobne">Nie udało się rozpoznać programu u sklepów z tej branży.</p>
          {% endif %}
        </div>
        <div class="pn-blok">
          <h4>Sklepy w tej branży</h4>
          <p>{{ b.przyklady|join(', ') }}.</p>
          <p class="pn-drobne">Najwięcej maili przysłały: {% for n in b.najczesciej %}{{ n.nazwa }} ({{ n.maile }}){{ loop.last ? '.' : ', ' }}{% endfor %}{% if b.cisza %} Do tego {{ b.cisza }} {{ b.cisza == 1 ? 'zapisany sklep nie przysłał' : 'zapisane sklepy nie przysłały' }} ani jednego maila przez co najmniej tydzień.{% endif %}</p>
        </div>
      </div>
    </article>
    {% endfor %}

    {% if d.inne_branze %}
    <p class="pn-drobne" style="margin-top:16px">Obserwuję też sklepy z branż, w których jest ich jeszcze za mało do porównania: {% for b in d.inne_branze %}{{ b.nazwa|lower }} ({{ b.sklepy }}){{ loop.last ? '.' : ', ' }}{% endfor %}</p>
    {% endif %}
  </section>

  <section id="ciekawostki">
    <div class="u-kicker">Ciekawostki</div>
    <h2>Co widać we wszystkich branżach</h2>
    <div class="pn-ciek">
      {% for c in d.ciekawostki %}<div><b>{{ c.liczba }}</b><p>{{ c.tekst }}</p></div>{% endfor %}
    </div>
  </section>

  <section id="dodaj">
    <div class="u-kicker">Dodaj swój sklep</div>
    <h2>Porównaj swój newsletter z branżą</h2>
    <div class="pn-sciezki">
      <div class="pn-sciezka">
        <span class="pn-etyk">Z zewnątrz · bez dostępu do konta</span>
        <h3>Zapiszę się do Twojego newslettera</h3>
        <p>Podaj adres sklepu. Zapiszę się do Twojego newslettera na skrzynkę testową i przez 14 dni policzę maile tak samo jak u innych sklepów: ile ich jest, w jakie dni i o której przychodzą, co jest w tematach, czy prosisz o potwierdzenie zapisu i co jest w powitaniu. <b>Wynik porównania z Twoją branżą wyślę Ci mailem w ciągu około 14 dni.</b> Działa przy każdym programie do mailingu.</p>
        <form id="pn-form" data-klucz="{{ function('mkpk_recaptcha_site_key') }}" novalidate>
          <input type="hidden" name="zrodlo" value="porownywarka">
          <div class="pn-pulapka" aria-hidden="true"><label>Strona firmy <input type="text" name="firma_www" tabindex="-1" autocomplete="off"></label></div>
          <div class="pn-dwa">
            <label>Adres sklepu<input type="text" name="sklep" inputmode="url" autocomplete="url" required maxlength="200" placeholder="np. twojsklep.pl"></label>
            <label>Branża
              <select name="branza" required>
                <option value="">Wybierz</option>
                {% for b in function('mkpk_porownywarka_branze') %}<option value="{{ b }}">{{ b }}</option>{% endfor %}
              </select>
            </label>
          </div>
          <label>E-mail, na który wyślę wynik<input type="email" name="email" autocomplete="email" required maxlength="120"></label>
          <label class="pn-zgoda"><input type="checkbox" name="zgoda" value="1" required><span>Zgadzam się na kontakt w sprawie wyniku porównania na podany adres e-mail.</span></label>
          <button type="submit">Dodaj sklep do porównania</button>
          <p class="pn-status" role="status" aria-live="polite"></p>
          <p class="pn-drobne">Dane z formularza wykorzystam wyłącznie, żeby przygotować i wysłać wynik porównania. Nie zapiszę Cię do żadnego newslettera. Administratorem danych jest Beaconator sp. z o.o. Szczegóły w <a href="/polityka-prywatnosci/">polityce prywatności</a>. Formularz chroni reCAPTCHA Google (<a href="https://policies.google.com/privacy">prywatność</a>, <a href="https://policies.google.com/terms">warunki</a>).</p>
        </form>
      </div>
      <div class="pn-sciezka">
        <span class="pn-etyk">Od środka · GetResponse i MailerLite</span>
        <h3>Pełny audyt mailingu</h3>
        <p>Z zewnątrz widać tylko to, co przychodzi do skrzynki. Jeśli używasz GetResponse albo MailerLite, darmowy skill do Claude Code sprawdzi Twoje konto od środka: automaty, przez które nikt nie przechodzi, maile bez liczenia sprzedaży i połączenie ze sklepem. Działa tylko w trybie odczytu, a raport po polsku zostaje na Twoim dysku.</p>
        <p><a class="u-cta" href="/audyt-mailingu/?zrodlo=porownywarka">Zobacz audyt mailingu</a></p>
      </div>
    </div>
  </section>

  <section id="metoda">
    <div class="u-kicker">Skąd te liczby</div>
    <h2>Jak liczę</h2>
    <ul class="pn-metoda">
      <li>Zapisuję się do publicznych newsletterów sklepów na jedną skrzynkę testową, tak jak zrobiłby to klient. Nie mam dostępu do kont mailingowych sklepów i widzę tylko to, co przychodzi do skrzynki.</li>
      <li>Okres: od {{ o.od_pl }} do {{ o.do_pl }} ({{ o.dni }} dni). W tym czasie był Black Week, dlatego maili sprzedażowych jest więcej niż zwykle. Sklepy dopisywałem stopniowo, więc część z nich obserwuję krócej.</li>
      <li>Zwykłe newslettery to wszystkie maile poza potwierdzeniem zapisu, powitaniem i przypomnieniem kodu powitalnego. Z nich liczę częstotliwość, dni, godziny, udział sprzedaży i tematy.</li>
      <li>Newslettery tygodniowo liczę tylko dla sklepów obserwowanych co najmniej {{ d.progi.min_dni_czestotliwosc }} dni. Typowy sklep to wartość środkowa: połowa sklepów wysyła mniej, połowa więcej.</li>
      <li>Godzina to czas, w którym mail dotarł do skrzynki, a nie czas zaplanowany przez sklep. Przy dwóch tygodniach obserwacji rozkład dni jest orientacyjny: drugi tydzień to już start Black Week.</li>
      <li>Program do wysyłki maili rozpoznaję po technicznych nagłówkach maili. Nie zawsze się da. Usługa, która tylko dostarcza maile (np. EmailLabs), nie musi być programem, w którym sklep układa kampanie.</li>
      <li>Branże z mniej niż {{ d.progi.min_sklepow_branzy }} sklepami podaję tylko z nazwy, bo to za mało do porównania. Nie oceniam sklepów, liczby opisują tylko to, co przyszło do skrzynki.</li>
      <li>Nie mierzę otwarć, kliknięć ani sprzedaży (widzi je tylko sklep), SMS-ów ani maili po zakupie. Na stronie nie pokazuję tematów ani treści maili.</li>
      <li>Liczby odświeżam po kolejnych tygodniach obserwacji. Ostatnia aktualizacja: {{ d.wygenerowano|date('d.m.Y') }}.</li>
    </ul>
  </section>
{% endif %}
</div></div>

<script nowprocket>
window.mkpkGa = window.mkpkGa || function (n, p) { try { window.dataLayer = window.dataLayer || []; if (typeof window.gtag === 'function') { window.gtag('event', n, p || {}); } else { (function () { window.dataLayer.push(arguments); })('event', n, p || {}); } } catch (e) {} };
(function () {
	var zr = new URLSearchParams(location.search).get('zrodlo');
	zr = zr ? zr.toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 60) : '';

	// Wybór branży: bez JS widać wszystkie karty, z JS jedną naraz.
	var przyciski = document.querySelectorAll('.pn-wybor [data-branza]');
	var karty = document.querySelectorAll('.pn [data-panel]');
	function pokazBranze(s, ga) {
		przyciski.forEach(function (b) { b.setAttribute('aria-selected', b.getAttribute('data-branza') === s ? 'true' : 'false'); b.tabIndex = b.getAttribute('data-branza') === s ? 0 : -1; });
		karty.forEach(function (k) { k.hidden = k.getAttribute('data-panel') !== s; });
		if (ga) mkpkGa('porownywarka_branza', {branza: s});
	}
	if (przyciski.length) {
		pokazBranze(przyciski[0].getAttribute('data-branza'), false);
		przyciski.forEach(function (b, i) {
			b.addEventListener('click', function () { pokazBranze(b.getAttribute('data-branza'), true); });
			b.addEventListener('keydown', function (e) {
				var j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
				if (j === null) return;
				var c = przyciski[(j + przyciski.length) % przyciski.length]; c.focus(); c.click();
			});
		});
	}

	var f = document.getElementById('pn-form');
	if (!f) return;
	if (zr) f.zrodlo.value = zr;
	var klucz = f.getAttribute('data-klucz');
	var status = f.querySelector('.pn-status');
	var przycisk = f.querySelector('button[type=submit]');
	function pokaz(t, ok) { status.textContent = t; status.className = 'pn-status ' + (ok ? 'ok' : 'blad'); }
	function zRecaptcha(cb) {
		if (!klucz) { cb(''); return; }
		function wykonaj() { grecaptcha.ready(function () { grecaptcha.execute(klucz, {action: 'porownywarka'}).then(cb, function () { cb(''); }); }); }
		if (window.grecaptcha && grecaptcha.execute) { wykonaj(); return; }
		var s = document.createElement('script');
		s.src = 'https://www.google.com/recaptcha/api.js?render=' + encodeURIComponent(klucz);
		s.onload = wykonaj; s.onerror = function () { cb(''); };
		document.head.appendChild(s);
	}
	f.addEventListener('submit', function (e) {
		e.preventDefault();
		if (!f.checkValidity()) { pokaz('Uzupełnij adres sklepu, branżę, e-mail i zaznacz zgodę.', false); f.reportValidity && f.reportValidity(); return; }
		przycisk.disabled = true; pokaz('Wysyłam…', true);
		zRecaptcha(function (token) {
			var branza = f.branza.value;
			var dane = new FormData(f);
			dane.append('action', 'mkpk_porownywarka');
			dane.append('recaptcha_token', token);
			fetch('/wp-admin/admin-ajax.php', {method: 'POST', body: dane, credentials: 'same-origin'})
				.then(function (r) { return r.json(); })
				.then(function (j) {
					var t = (j && j.data && j.data.message) || (j && j.success ? 'Dziękuję, zgłoszenie przyjęte.' : 'Nie udało się wysłać. Napisz bezpośrednio na wnowak@autilo.eu.');
					pokaz(t, !!(j && j.success));
					if (j && j.success) { mkpkGa('porownywarka_zgloszenie', {branza: branza, zrodlo: f.zrodlo.value}); f.reset(); f.zrodlo.value = zr || 'porownywarka'; } else { przycisk.disabled = false; }
				})
				.catch(function () { pokaz('Błąd połączenia. Napisz bezpośrednio na wnowak@autilo.eu.', false); przycisk.disabled = false; });
		});
	});
})();
</script>
{% endblock %}
