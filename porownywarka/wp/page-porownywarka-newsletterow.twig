{% extends "templates/usluga.twig" %}
{# Porównywarka newsletterów sklepów (repo Autilos/audyt-mailingu, porownywarka/wp/). 26.11.2026, v3 (+ podwójne potwierdzenie zapisu)
   Wszystkie liczby z jednego pliku: function('mkpk_porownywarka_dane') = uploads/mkpk-porownywarka/dane.json
   (generuje porownywarka/generuj_dane.py). Style zawężone do .usl .pn. Formularz: mu-plugins/mkpk-porownywarka.php. #}
{% block custom_head %}
{{ parent() }}
<style>
.usl .pn{--czerw:#c8102e;--linia:rgba(215,187,121,.28)}
.usl .pn section{scroll-margin-top:70px;padding:48px 0 0}
.usl .pn .pn-hero{padding:40px 0 0}
.usl .pn h1{font-size:clamp(2.1rem,7vw,4.2rem)}
.usl .pn .u-lead{margin-top:18px!important}
.usl .pn .pn-uwaga{margin:18px 0 0;max-width:760px;border-left:4px solid var(--czerw);background:rgba(200,16,46,.12);padding:12px 16px;border-radius:0 8px 8px 0;font-size:.95rem}
.usl .pn .pn-uwaga b{color:#fff4dc}
.usl .pn .pn-btn2{display:inline-block;margin-top:22px;border:1px solid var(--zloto);color:var(--tekst)!important;text-decoration:none;padding:12px 22px;border-radius:6px;font-weight:600}
.usl .pn .pn-btn2:hover{background:rgba(215,187,121,.12)}
.usl .pn .pn-drobne{font-size:.85rem;color:var(--szary);margin:8px 0 0;line-height:1.55}
/* tabela porównawcza */
.usl .pn .pn-podpowiedz{margin:0 0 14px;font-size:.95rem}
.usl .pn .pn-tabwrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid rgba(215,187,121,.35);border-radius:12px;background:rgba(20,0,2,.45)}
.usl .pn table.pn-tab{width:100%;border-collapse:collapse;font-size:1rem;line-height:1.25}
.usl .pn .pn-tab th,.usl .pn .pn-tab td{padding:12px 10px;border-bottom:1px solid var(--linia);text-align:center;vertical-align:middle}
.usl .pn .pn-tab thead th{font-family:var(--mono);font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;color:var(--zloto);font-weight:400;line-height:1.35;vertical-align:bottom}
.usl .pn .pn-tab thead th:first-child,.usl .pn .pn-tab tbody th,.usl .pn .pn-tab tfoot th{text-align:left}
.usl .pn .pn-tab td{font-weight:700;color:#fff4dc;white-space:nowrap}
.usl .pn .pn-tab td small{font-weight:400;color:var(--szary);font-size:.8em}
.usl .pn .pn-tab tbody tr{cursor:pointer}
.usl .pn .pn-tab tbody tr:hover{background:rgba(215,187,121,.07)}
.usl .pn .pn-tab tbody tr.wybrany{background:rgba(215,187,121,.16)}
.usl .pn .pn-tab tbody tr.wybrany th button{color:var(--zloto)}
.usl .pn .pn-tab th button{all:unset;cursor:pointer;font-weight:700;color:#fff4dc;display:block;line-height:1.25}
.usl .pn .pn-tab th button:after{content:" ›";color:var(--zloto)}
.usl .pn .pn-tab th button:focus-visible{outline:2px solid #fff;outline-offset:3px}
.usl .pn .pn-tab th small{display:block;font-weight:400;color:var(--szary);font-size:.78rem;margin-top:2px}
.usl .pn .pn-tab td.pn-max{background:rgba(134,239,172,.16);box-shadow:inset 0 0 0 2px rgba(134,239,172,.55)}
.usl .pn .pn-tab td.pn-min{background:rgba(255,138,148,.14);box-shadow:inset 0 0 0 2px rgba(255,138,148,.55)}
.usl .pn .pn-tab tfoot th,.usl .pn .pn-tab tfoot td{border-bottom:0;border-top:2px solid rgba(215,187,121,.55);color:var(--zloto)}
.usl .pn .pn-legenda{display:flex;flex-wrap:wrap;gap:6px 16px;margin:10px 0 0;font-size:.85rem;color:var(--szary)}
.usl .pn .pn-legenda span:before{content:"";display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.usl .pn .pn-legenda .l-max:before{background:rgba(134,239,172,.3);box-shadow:inset 0 0 0 2px rgba(134,239,172,.7)}
.usl .pn .pn-legenda .l-min:before{background:rgba(255,138,148,.25);box-shadow:inset 0 0 0 2px rgba(255,138,148,.7)}
.usl .pn .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
/* karta branży */
.usl .pn .pn-karta{margin-top:18px;scroll-margin-top:80px;background:linear-gradient(180deg,var(--karta),var(--tlo2));border:1px solid rgba(215,187,121,.35);border-top:3px solid var(--czerw);border-radius:14px;padding:22px 18px}
.usl .pn .pn-karta[hidden]{display:none}
.usl .pn .pn-karta h3{font-size:1.3rem;margin:0 0 12px}
.usl .pn .pn-wnioski{margin:0;padding:0;list-style:none;display:grid;gap:10px}
.usl .pn .pn-wnioski li{padding-left:22px;position:relative;font-size:1.02rem}
.usl .pn .pn-wnioski li:before{content:"";position:absolute;left:2px;top:.62em;width:9px;height:9px;border-radius:50%;background:var(--zloto)}
.usl .pn .pn-blok{margin-top:20px}
.usl .pn .pn-blok h4{margin:0 0 10px;font-size:1rem;color:#fff4dc}
.usl .pn .pn-blok p{margin:0;font-size:.95rem}
.usl .pn .pn-dni{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;align-items:end;height:100px;margin:0 0 6px}
.usl .pn .pn-dni div{display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;gap:4px}
.usl .pn .pn-dni i{display:block;width:100%;max-width:44px;background:var(--zloto);border-radius:4px 4px 0 0;min-height:2px}
.usl .pn .pn-dni em{font-style:normal;font-family:var(--mono);font-size:.72rem;color:var(--szary)}
.usl .pn .pn-dni-podpis{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;text-align:center;font-family:var(--mono);font-size:.75rem;color:var(--zloto);margin-bottom:8px}
.usl .pn details{margin-top:18px;border-top:1px solid var(--linia);padding-top:12px}
.usl .pn summary{cursor:pointer;color:var(--zloto);font-weight:600;font-size:.95rem;min-height:32px}
.usl .pn details p{margin:8px 0 0;font-size:.92rem;color:var(--szary)}
/* podwójne potwierdzenie zapisu */
.usl .pn .pn-doi{display:grid;grid-template-columns:1fr;gap:22px;margin-top:6px}
.usl .pn .pn-doi-liczba{border:1px solid rgba(215,187,121,.35);border-top:3px solid var(--czerw);border-radius:14px;padding:20px 18px;background:linear-gradient(180deg,var(--karta),var(--tlo2))}
.usl .pn .pn-doi-liczba b{display:block;font-size:3rem;line-height:1;color:var(--zloto);font-weight:800}
.usl .pn .pn-doi-liczba p{margin:8px 0 0;font-size:1.02rem}
.usl .pn .pn-doi-liczba .pn-doi-znaczy{margin-top:14px;padding-top:12px;border-top:1px solid var(--linia);font-size:.95rem}
.usl .pn .pn-doi-br{margin:0;padding:0;list-style:none;display:grid;gap:9px}
.usl .pn .pn-doi-br li{display:grid;grid-template-columns:7.5em 1fr 4.6em;gap:10px;align-items:center;font-size:.95rem}
.usl .pn .pn-doi-br .pn-pasek{height:12px;border-radius:6px;background:rgba(215,187,121,.15);overflow:hidden}
.usl .pn .pn-doi-br .pn-pasek i{display:block;height:100%;background:var(--zloto);border-radius:6px}
.usl .pn .pn-doi-br em{font-style:normal;text-align:right;font-weight:700;color:#fff4dc;white-space:nowrap}
.usl .pn .pn-doi-br em small{font-weight:400;color:var(--szary)}
.usl .pn .pn-doi-br li.og{border-top:1px solid var(--linia);padding-top:9px;color:var(--zloto)}
/* ciekawostki */
.usl .pn .pn-ciek{display:grid;grid-template-columns:1fr;gap:12px}
.usl .pn .pn-ciek div{border:1px solid var(--linia);border-radius:12px;padding:16px 18px;background:rgba(41,0,4,.6)}
.usl .pn .pn-ciek b{display:block;font-size:1.9rem;line-height:1.1;color:var(--zloto);font-weight:800;margin-bottom:4px}
.usl .pn .pn-ciek p{margin:0;font-size:.98rem}
/* dodaj sklep */
.usl .pn .pn-sciezki{display:grid;grid-template-columns:1fr;gap:16px}
.usl .pn .pn-sciezka{border:1px solid var(--zloto);border-radius:14px;padding:22px 18px;background:linear-gradient(180deg,var(--karta),var(--tlo2))}
.usl .pn .pn-sciezka .pn-etyk{display:inline-block;font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;background:var(--czerw);color:#fff;padding:3px 8px;border-radius:3px;margin-bottom:10px}
.usl .pn .pn-sciezka h3{margin:0 0 8px;font-size:1.25rem}
.usl .pn form{display:grid;gap:14px;margin-top:16px}
.usl .pn form label{display:grid;gap:5px;font-size:.85rem;color:var(--zloto);font-weight:600}
.usl .pn form input[type=text],.usl .pn form input[type=email],.usl .pn form select{width:100%;padding:12px 13px;border-radius:8px;border:1px solid rgba(215,187,121,.55);background:#140002;color:#fff;font-size:16px;line-height:1.4;font-family:inherit}
.usl .pn form input:focus,.usl .pn form select:focus{outline:2px solid var(--zloto);outline-offset:1px}
.usl .pn form .pn-zgoda{display:flex;gap:10px;align-items:flex-start;color:var(--tekst);font-weight:400;font-size:.9rem}
.usl .pn form .pn-zgoda input{margin-top:4px;width:20px;height:20px;flex:none;accent-color:#d7bb79}
.usl .pn form .pn-pulapka{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.usl .pn form button{background:var(--zloto);color:#290004;font-weight:700;font-size:1rem;border:0;border-radius:8px;padding:14px 26px;cursor:pointer;min-height:48px}
.usl .pn form button[disabled]{opacity:.6;cursor:wait}
.usl .pn .pn-status{min-height:1.4em;margin:0;font-weight:600}
.usl .pn .pn-status.ok{color:#86efac}
.usl .pn .pn-status.blad{color:#ff8a94}
.usl .pn .pn-metoda{max-width:820px;padding-left:20px}
.usl .pn .pn-metoda li{margin:0 0 10px}
@media (min-width:700px){
  .usl .pn .pn-karta{padding:26px 28px}
  .usl .pn .pn-dwie{display:grid;grid-template-columns:1fr 1fr;gap:28px}
  .usl .pn .pn-ciek{grid-template-columns:repeat(2,1fr)}
  .usl .pn .pn-doi{grid-template-columns:1fr 1.2fr;gap:32px}
  .usl .pn .pn-sciezki{grid-template-columns:1.25fr 1fr}
  .usl .pn form .pn-dwa{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .usl .pn form button{justify-self:start}
  .usl .pn .pn-tab th,.usl .pn .pn-tab td{padding:13px 16px}
  .usl .pn .pn-tab td{font-size:1.15rem}
}
@media (max-width:699px){
  .usl .pn form button{width:100%}
  .usl .pn table.pn-tab{font-size:.92rem}
  .usl .pn .pn-tab th,.usl .pn .pn-tab td{padding:10px 5px}
  .usl .pn .pn-tab th:first-child{padding-left:10px}
  .usl .pn .pn-tab thead th{font-family:inherit;text-transform:none;letter-spacing:0;font-size:.72rem;font-weight:600;line-height:1.25}
  .usl .pn .pn-tab td small{display:block;font-size:.72rem}
  .usl .pn .pn-tab th small{font-size:.7rem}
  .usl .pn .pn-tab th button:after{content:""}
}
</style>
{% endblock %}

{% block content %}
{% set d = function('mkpk_porownywarka_dane') %}
{# Sekcja „Jak liczę” — na razie ukryta (decyzja Wojtka 26.11). Przywrócenie: true. #}
{% set pokaz_metode = false %}
<div class="usl"><div class="pn">
{% if not d %}
  <section class="pn-hero">
    <div class="u-kicker">Porównywarka newsletterów</div>
    <h1>Jak mailują polskie sklepy?</h1>
    <p class="u-lead">Dane są w przygotowaniu. Zajrzyj za kilka dni.</p>
  </section>
{% else %}
  {% set l = d.liczby %}
  {% set o = d.okres %}
  {% set og = d.ogolem %}
  <section class="pn-hero">
    <div class="u-kicker">Porównywarka newsletterów · {{ o.od_pl }}–{{ o.do_pl }}</div>
    <h1>Jak mailują polskie sklepy?</h1>
    <p class="u-lead">Zapisałem się do newsletterów {{ l.sklepy_zapisane }} polskich sklepów i liczę każdy mail: przez {{ o.dni }} dni przyszło {{ l.maile }} maili od {{ l.sklepy_wysylajace }} sklepów.</p>
    <p class="pn-uwaga"><b>W tym czasie był Black Week</b>, więc maili z rabatami jest więcej niż w spokojnym miesiącu.</p>
    <a class="pn-btn2" href="#dodaj">Dodaj swój sklep do porównania</a>
  </section>

  <section id="branze">
    <div class="u-kicker">Porównanie branż</div>
    <h2>Jak piszą sklepy z Twojej branży</h2>
    <p class="pn-podpowiedz">Kliknij branżę, żeby zobaczyć, co to znaczy dla Twojego sklepu.</p>
    <div class="pn-tabwrap">
      <table class="pn-tab">
        <thead>
          <tr>
            <th scope="col">Branża</th>
            <th scope="col">Maili w tygodniu</th>
            <th scope="col">Ile to oferty i rabaty</th>
            <th scope="col">Potwier&shy;dzenie zapisu kliknię&shy;ciem</th>
            <th scope="col">Rabat na powitanie</th>
          </tr>
        </thead>
        <tbody>
          {% for b in d.branze %}
          {% set t = b.tabela %}
          {% set w = b.wyroznienie %}
          <tr data-wiersz="{{ b.slug }}">
            <th scope="row"><button type="button" data-branza="{{ b.slug }}" aria-controls="pn-{{ b.slug }}" aria-pressed="false">{{ b.nazwa }}{% if b.malo_danych %}*{% endif %}</button><small>{{ b.sklepy }} {{ b.sklepy in [2,3,4] or (b.sklepy % 10 in [2,3,4] and b.sklepy % 100 not in [12,13,14]) ? 'sklepy' : 'sklepów' }}</small></th>
            {% for k in ['tydzien', 'oferty', 'potwierdzenie', 'powitanie'] %}
            {% set wy = w[k] ?? null %}
            <td{% if wy %} class="pn-{{ wy }}"{% endif %}>
              {%- if k == 'tydzien' -%}{{ t.tydzien ?? '–' }}
              {%- elseif k == 'oferty' -%}{{ t.oferty_proc is not null ? t.oferty_proc ~ '%' : '–' }}
              {%- elseif k == 'potwierdzenie' -%}{{ t.potwierdzenie.prosi }} <small>z {{ t.potwierdzenie.sklepy }}</small>
              {%- else -%}{% if t.powitanie.sklepy %}{{ t.powitanie.z_rabatem }} <small>z {{ t.powitanie.sklepy }}</small>{% else %}–{% endif %}
              {%- endif -%}
              {%- if wy %}<span class="sr"> ({{ wy == 'max' ? 'najwięcej' : 'najmniej' }})</span>{% endif -%}
            </td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Wszystkie sklepy<small>{{ og.sklepy }} sklepów</small></th>
            <td>{{ og.tydzien ?? '–' }}</td>
            <td>{{ og.oferty_proc }}%</td>
            <td>{{ og.potwierdzenie.prosi }} <small>z {{ og.potwierdzenie.sklepy }}</small></td>
            <td>{{ og.powitanie.z_rabatem }} <small>z {{ og.powitanie.sklepy }}</small></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="pn-legenda"><span class="l-max">najwięcej w kolumnie</span><span class="l-min">najmniej w kolumnie</span></p>
    <p class="pn-drobne">Liczę newslettery (bez maili powitalnych i potwierdzeń). „Potwierdzenie zapisu kliknięciem”: ile sklepów po zapisie każe kliknąć w link w mailu, zanim zacznie wysyłać newsletter. „Maili w tygodniu” to typowy sklep: połowa sklepów wysyła mniej, połowa więcej. „Rabat na powitanie” liczę wśród sklepów, które przysłały mail powitalny. * Mało maili, liczby orientacyjne, bez wyróżnień kolorem.{% if d.inne_branze %} Za mało sklepów do porównania mają jeszcze: {% for b in d.inne_branze %}{{ b.nazwa|lower }} ({{ b.sklepy }}){{ loop.last ? '.' : ', ' }}{% endfor %}{% endif %}</p>

    {% for b in d.branze %}
    <article class="pn-karta" id="pn-{{ b.slug }}" data-panel="{{ b.slug }}">
      <h3>{{ b.nazwa }}: co to znaczy dla Twojego sklepu</h3>
      <ul class="pn-wnioski">{% for z in b.wnioski %}<li>{{ z }}</li>{% endfor %}</ul>
      {% if b.malo_danych %}<p class="pn-drobne">Mało maili z tej branży, więc traktuj te liczby orientacyjnie.</p>{% endif %}
      <div class="pn-dwie">
        <div class="pn-blok">
          <h4>W jakie dni przychodzą newslettery</h4>
          <div class="pn-dni" aria-hidden="true">
            {% for x in b.dni %}<div><em>{{ x.proc }}%</em><i style="height:{{ (x.wys * 0.75)|round }}%"></i></div>{% endfor %}
          </div>
          <div class="pn-dni-podpis" aria-hidden="true">{% for x in b.dni %}<span>{{ x.dzien }}</span>{% endfor %}</div>
          <p>{% if b.dni_top %}Najwięcej przychodzi {{ b.dni_top|join(', ', ' i ') }}.{% else %}Rozkładają się na różne dni bez wyraźnej przewagi.{% endif %}</p>
        </div>
        <div class="pn-blok">
          <h4>Najwięcej maili przysłały</h4>
          <p>{% for n in b.najczesciej %}{{ n.nazwa }} ({{ n.maile }}){{ loop.last ? '.' : ', ' }}{% endfor %}</p>
          {% if b.systemy_linia %}
          <h4 style="margin-top:16px">Programy do wysyłki</h4>
          <p>{{ b.systemy_linia }}.</p>
          {% endif %}
        </div>
      </div>
      <details>
        <summary>Pokaż wszystkie sklepy ({{ b.sklepy }})</summary>
        <p>{{ b.przyklady|join(', ') }}.</p>
      </details>
    </article>
    {% endfor %}
  </section>

  {% set p = d.podwojne ?? null %}
  {% if p and p.sklepy %}
  <section id="potwierdzenie">
    <div class="u-kicker">Podwójne potwierdzenie zapisu</div>
    <h2>Ile sklepów każe potwierdzić zapis kliknięciem</h2>
    <div class="pn-doi">
      <div class="pn-doi-liczba">
        <b>{{ p.proc }}%</b>
        <p>sklepów ({{ p.z_potwierdzeniem }} z {{ p.sklepy }}) po zapisie przysyła mail z linkiem, w który trzeba kliknąć, żeby zacząć dostawać newsletter. Pozostałe {{ p.bez }} od razu wysyłają powitanie albo ofertę.</p>
        {% if p.z_zacheta %}<p>{{ p.z_zacheta }} {{ p.z_zacheta == 1 ? 'sklep kusi' : (p.z_zacheta % 10 in [2,3,4] and p.z_zacheta % 100 not in [12,13,14] ? 'sklepy kuszą' : 'sklepów kusi') }} rabatem już w temacie tego maila{% if p.przyklady_zachety %}, na przykład {{ p.przyklady_zachety|join(', ', ' i ') }}{% endif %}.</p>{% endif %}
        {% if p.poprzedni %}<p class="pn-drobne">Poprzedni pomiar ({{ p.poprzedni.data_pl }}): {{ p.poprzedni.z_potwierdzeniem }} z {{ p.poprzedni.sklepy }} ({{ p.poprzedni.proc }}%).</p>{% endif %}
        <p class="pn-doi-znaczy"><b style="display:inline;font-size:inherit;color:#fff4dc">Co to znaczy dla Twojego sklepu:</b> potwierdzenie kliknięciem daje czystszą bazę i mniej zgłoszeń Twoich maili jako spam, ale część osób nie kliknie w link i nie trafi na listę.</p>
      </div>
      <div>
        <h3 style="font-size:1.1rem;margin:0 0 12px">W branżach</h3>
        <ul class="pn-doi-br">
          {% for b in p.branze %}<li><span>{{ b.nazwa }}</span><span class="pn-pasek" aria-hidden="true"><i style="width:{{ b.proc }}%"></i></span><em>{{ b.z_potwierdzeniem }} <small>z {{ b.sklepy }}</small></em></li>{% endfor %}
          <li class="og"><span>Wszystkie</span><span class="pn-pasek" aria-hidden="true"><i style="width:{{ p.proc }}%"></i></span><em>{{ p.z_potwierdzeniem }} <small>z {{ p.sklepy }}</small></em></li>
        </ul>
        <p class="pn-drobne">Liczę sklepy, od których przyszedł choć jeden mail.{% if p.tylko_podziekowanie %} Wliczam też {{ p.tylko_podziekowanie }} {{ p.tylko_podziekowanie == 1 ? 'sklep' : (p.tylko_podziekowanie % 10 in [2,3,4] and p.tylko_podziekowanie % 100 not in [12,13,14] ? 'sklepy' : 'sklepów') }}, od których mam tylko podziękowanie za potwierdzenie, bo prośba przyszła, zanim zacząłem zbierać maile.{% endif %} Aktualizacja: {{ d.wygenerowano|date('d.m.Y') }}.</p>
      </div>
    </div>
  </section>
  {% endif %}

  {% if d.ciekawostki %}
  <section id="ciekawostki">
    <div class="u-kicker">Ciekawostki</div>
    <h2>Co jeszcze widać we wszystkich branżach</h2>
    <div class="pn-ciek">
      {% for c in d.ciekawostki|slice(0, 4) %}<div><b>{{ c.liczba }}</b><p>{{ c.tekst }}</p></div>{% endfor %}
    </div>
  </section>
  {% endif %}

  <section id="dodaj">
    <div class="u-kicker">Dodaj swój sklep</div>
    <h2>Porównaj swój newsletter z branżą</h2>
    <div class="pn-sciezki">
      <div class="pn-sciezka">
        <span class="pn-etyk">Z zewnątrz · bez dostępu do konta</span>
        <h3>Zapiszę się do Twojego newslettera</h3>
        <p>Podaj adres sklepu. Przez 14 dni policzę Twoje maile tak samo jak u innych sklepów. <b>Wynik na tle Twojej branży wyślę Ci mailem w ciągu około 14 dni.</b> Działa przy każdym programie do mailingu.</p>
        <form id="pn-form" data-klucz="{{ function('mkpk_recaptcha_site_key') }}" novalidate>
          <input type="hidden" name="zrodlo" value="porownywarka">
          <div class="pn-pulapka" aria-hidden="true"><label>Strona firmy <input type="text" name="firma_www" tabindex="-1" autocomplete="off"></label></div>
          <div class="pn-dwa">
            <label>Adres sklepu<input type="text" name="sklep" inputmode="url" autocomplete="url" required maxlength="200" placeholder="np. twojsklep.pl"></label>
            <label>Branża
              <select name="branza" required>
                <option value="">Wybierz</option>
                {% for b in function('mkpk_porownywarka_branze') %}<option value="{{ b }}">{{ b }}</option>{% endfor %}
              </select>
            </label>
          </div>
          <label>E-mail, na który wyślę wynik<input type="email" name="email" autocomplete="email" required maxlength="120"></label>
          <label class="pn-zgoda"><input type="checkbox" name="zgoda" value="1" required><span>Zgadzam się na kontakt w sprawie wyniku porównania na podany adres e-mail.</span></label>
          <button type="submit">Dodaj sklep do porównania</button>
          <p class="pn-status" role="status" aria-live="polite"></p>
          <p class="pn-drobne">Dane z formularza wykorzystam wyłącznie, żeby przygotować i wysłać wynik porównania. Nie zapiszę Cię do żadnego newslettera. Administratorem danych jest Beaconator sp. z o.o. Szczegóły w <a href="/polityka-prywatnosci/">polityce prywatności</a>. Formularz chroni reCAPTCHA Google (<a href="https://policies.google.com/privacy">prywatność</a>, <a href="https://policies.google.com/terms">warunki</a>).</p>
        </form>
      </div>
      <div class="pn-sciezka">
        <span class="pn-etyk">Od środka · GetResponse i MailerLite</span>
        <h3>Pełny audyt mailingu</h3>
        <p>Z zewnątrz widać tylko to, co przychodzi do skrzynki. Jeśli używasz GetResponse albo MailerLite, darmowy skill do Claude Code sprawdzi Twoje konto od środka: automaty, przez które nikt nie przechodzi, i maile bez liczenia sprzedaży. Działa tylko w trybie odczytu.</p>
        <p><a class="u-cta" href="/audyt-mailingu/?zrodlo=porownywarka">Zobacz audyt mailingu</a></p>
      </div>
    </div>
  </section>

  {% if pokaz_metode %}
  <section id="metoda">
    <div class="u-kicker">Skąd te liczby</div>
    <h2>Jak liczę</h2>
    <ul class="pn-metoda">
      <li>Zapisuję się do publicznych newsletterów sklepów na jedną skrzynkę testową, tak jak zrobiłby to klient. Nie mam dostępu do kont mailingowych sklepów i widzę tylko to, co przychodzi do skrzynki.</li>
      <li>Okres: od {{ o.od_pl }} do {{ o.do_pl }} ({{ o.dni }} dni), w tym Black Week. Sklepy dopisywałem stopniowo, więc część z nich obserwuję krócej.</li>
      <li>Liczę newslettery (bez maili powitalnych i potwierdzeń). Maile w tygodniu liczę tylko dla sklepów, które obserwuję od co najmniej {{ d.progi.min_dni_czestotliwosc }} dni. Typowy sklep to wartość środkowa: połowa sklepów wysyła mniej, połowa więcej.</li>
      <li>Program do wysyłki rozpoznaję po technicznych nagłówkach maili. Nie zawsze się da.</li>
      <li>Branże z mniej niż {{ d.progi.min_sklepow_branzy }} sklepami podaję tylko z nazwy. Nie oceniam sklepów i nie pokazuję tematów ani treści maili. Nie mierzę otwarć, kliknięć ani sprzedaży.</li>
      <li>Ostatnia aktualizacja: {{ d.wygenerowano|date('d.m.Y') }}.</li>
    </ul>
  </section>
  {% endif %}
{% endif %}
</div></div>

<script nowprocket>
window.mkpkGa = window.mkpkGa || function (n, p) { try { window.dataLayer = window.dataLayer || []; if (typeof window.gtag === 'function') { window.gtag('event', n, p || {}); } else { (function () { window.dataLayer.push(arguments); })('event', n, p || {}); } } catch (e) {} };
(function () {
	var zr = new URLSearchParams(location.search).get('zrodlo');
	zr = zr ? zr.toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 60) : '';

	// Wybór branży z tabeli: bez JS widać wszystkie karty, z JS jedną naraz (pod tabelą).
	// aria-pressed, nie aria-expanded: sdc.js motywu podpina się pod każdy [aria-expanded] jako akordeon.
	var przyciski = document.querySelectorAll('.pn-tab [data-branza]');
	var wiersze = document.querySelectorAll('.pn-tab [data-wiersz]');
	var karty = document.querySelectorAll('.pn [data-panel]');
	function pokazBranze(s, klik) {
		przyciski.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-branza') === s ? 'true' : 'false'); });
		wiersze.forEach(function (w) { w.classList.toggle('wybrany', w.getAttribute('data-wiersz') === s); });
		var karta = null;
		karty.forEach(function (k) { k.hidden = k.getAttribute('data-panel') !== s; if (!k.hidden) karta = k; });
		if (klik) {
			mkpkGa('porownywarka_branza', {branza: s});
			if (karta && karta.getBoundingClientRect().top > window.innerHeight * 0.6) karta.scrollIntoView({behavior: 'smooth', block: 'start'});
		}
	}
	if (przyciski.length) {
		pokazBranze(przyciski[0].getAttribute('data-branza'), false);
		wiersze.forEach(function (w) {
			w.addEventListener('click', function () { pokazBranze(w.getAttribute('data-wiersz'), true); });
		});
	}

	var f = document.getElementById('pn-form');
	if (!f) return;
	if (zr) f.zrodlo.value = zr;
	var klucz = f.getAttribute('data-klucz');
	var status = f.querySelector('.pn-status');
	var przycisk = f.querySelector('button[type=submit]');
	function pokaz(t, ok) { status.textContent = t; status.className = 'pn-status ' + (ok ? 'ok' : 'blad'); }
	function zRecaptcha(cb) {
		if (!klucz) { cb(''); return; }
		function wykonaj() { grecaptcha.ready(function () { grecaptcha.execute(klucz, {action: 'porownywarka'}).then(cb, function () { cb(''); }); }); }
		if (window.grecaptcha && grecaptcha.execute) { wykonaj(); return; }
		var s = document.createElement('script');
		s.src = 'https://www.google.com/recaptcha/api.js?render=' + encodeURIComponent(klucz);
		s.onload = wykonaj; s.onerror = function () { cb(''); };
		document.head.appendChild(s);
	}
	f.addEventListener('submit', function (e) {
		e.preventDefault();
		if (!f.checkValidity()) { pokaz('Uzupełnij adres sklepu, branżę, e-mail i zaznacz zgodę.', false); f.reportValidity && f.reportValidity(); return; }
		przycisk.disabled = true; pokaz('Wysyłam…', true);
		zRecaptcha(function (token) {
			var branza = f.branza.value;
			var dane = new FormData(f);
			dane.append('action', 'mkpk_porownywarka');
			dane.append('recaptcha_token', token);
			fetch('/wp-admin/admin-ajax.php', {method: 'POST', body: dane, credentials: 'same-origin'})
				.then(function (r) { return r.json(); })
				.then(function (j) {
					var t = (j && j.data && j.data.message) || (j && j.success ? 'Dziękuję, zgłoszenie przyjęte.' : 'Nie udało się wysłać. Napisz bezpośrednio na wnowak@autilo.eu.');
					pokaz(t, !!(j && j.success));
					if (j && j.success) { mkpkGa('porownywarka_zgloszenie', {branza: branza, zrodlo: f.zrodlo.value}); f.reset(); f.zrodlo.value = zr || 'porownywarka'; } else { przycisk.disabled = false; }
				})
				.catch(function () { pokaz('Błąd połączenia. Napisz bezpośrednio na wnowak@autilo.eu.', false); przycisk.disabled = false; });
		});
	});
})();
</script>
{% endblock %}
